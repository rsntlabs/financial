{
  "name": "yfinance-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "vite",
    "build": "npm run wasm && npm run build:ui",
    "build:ui": "tsc --noEmit && vite build",

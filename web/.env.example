# Optional static-host subdirectory. Never place API keys in build variables.
# BASE_PATH=/financials/

# Deployed Cloudflare Worker origin that proxies Yahoo Finance and SEC EDGAR
# requests (see ../worker and docs/providers.md). For local development, run
# `npm run dev` in ../worker (wrangler dev) and use its printed origin.
VITE_PROVIDER_PROXY_URL=http://127.0.0.1:8787

# Optional logo host for the company mark beside the company name, with
# {ticker} (or {ticker_lower}) standing in for the symbol. Leave it out for
# the default host; set it empty to request no logos, which draws every
# company's ticker monogram instead. Logos are plain images and never carry
# an API key.
# VITE_TICKER_LOGO_URL=https://assets.parqet.com/logos/symbol/{ticker}?format=png&size=128
